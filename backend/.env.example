# Copy this file to .env and fill in real values.
# NEVER commit the real .env file to GitHub (it is already in .gitignore).

# --- Required: AI providers ---
# Transcription (speech-to-text with timestamps). Get a key at https://platform.openai.com/api-keys
# Whisper API billing is pay-per-minute (cheap, but NOT free). You must add billing to your OpenAI account.
OPENAI_API_KEY=

# Clip/moment analysis, titles, descriptions, hashtags. Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# --- Server ---
PORT=8080

# Comma-separated list of allowed frontend origins (your GitHub Pages URL(s)).
# Example: https://yourusername.github.io
FRONTEND_ORIGIN=https://yourusername.github.io

# --- Upload limits ---
# Max upload size in MB
MAX_UPLOAD_MB=500

# --- Clip generation defaults (seconds) ---
MIN_CLIP_SECONDS=15
MAX_CLIP_SECONDS=90
DEFAULT_CLIP_SECONDS=35

# --- Storage cleanup ---
# How long (minutes) a finished job's files are kept before automatic deletion
CLEANUP_AFTER_MINUTES=120

# --- Rate limiting ---
# Max job-creation requests per IP per window
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=10
